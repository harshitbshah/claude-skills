#!/usr/bin/env bash
# Headless front end for Claude Code skills on the VM, for Meta Muse over SSH.
#
#   muse-skill <skill> start [args]   # run /<skill> [args]; prints the first table or the result
#   muse-skill <skill> reply "<text>" # answer the last "Reply with:" prompt
#   muse-skill <skill> status         # is a run waiting for an answer?
#
# The conversation is kept between calls via --resume. Data files live in ~/skill-data/<skill>/
# (symlinked from the skill dir), because headless runs can't write inside ~/.claude/.

set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$HERE/skills.sh"

SKILL="${1:-}"; shift || true
skill_config "$SKILL" || { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:$PATH"
export PYTHON_KEYRING_BACKEND=keyrings.alt.file.PlaintextKeyring
# Long-lived Claude token from `claude setup-token` (CLAUDE_CODE_OAUTH_TOKEN=..., chmod 600).
TOKEN_FILE="$HOME/.config/review-txn/env"
[[ -f "$TOKEN_FILE" ]] && { set -a; . "$TOKEN_FILE"; set +a; }

STATE_DIR="$HOME/.cache/muse-skill"; mkdir -p "$STATE_DIR"
SESSION_FILE="$STATE_DIR/$SKILL.session"
DATA_DIR="$HOME/skill-data/$SKILL"
SKILL_DIR="$HOME/.claude/skills/$SKILL"
cd "$HOME"

CONTEXT="You are running headless ON THE VM (hostname clouddesktop), started for Meta Muse; there is no live chat. \
The data is local: skip sync.sh entirely (pull and push are no-ops here). \
The data files are symlinks in $SKILL_DIR/ pointing into $DATA_DIR/; Glob may not list them, so Read them \
directly by full path ($DATA_FILES) and write them back through the same paths. \
End every turn that needs a decision with the table and a 'Reply with:' line, nothing after it; \
the user's answer arrives as the next prompt. Never treat a missing reply as approval. \
Keep output phone-friendly. $EXTRA_CONTEXT"

run_claude() {
  local out
  out="$(claude -p --output-format json --permission-mode acceptEdits --add-dir "$DATA_DIR" \
          --append-system-prompt "$CONTEXT" --allowedTools="$ALLOWED,Read,Glob,Grep,Skill,Edit(~/skill-data/$SKILL/**)" \
          --disallowedTools="$DENIED" "$@" </dev/null)" || {
    echo "Claude run failed:"; echo "$out" | tail -5; exit 1; }
  OUT="$out" python3 - "$SESSION_FILE" <<'PY'
import json, os, sys
d = json.loads(os.environ["OUT"])
res = d.get("result") or ""
if "Reply with:" in res and d.get("session_id"):
    open(sys.argv[1], "w").write(d["session_id"])      # waiting for an answer
elif os.path.exists(sys.argv[1]):
    os.remove(sys.argv[1])                               # finished: nothing to resume
print(res or d)
PY
}

case "${1:-}" in
  start)  shift; run_claude "/$SKILL${*:+ $*}" ;;
  reply)  shift
          [[ $# -ge 1 ]] || { echo "usage: $(basename "$0") reply \"<text>\""; exit 1; }
          [[ -s "$SESSION_FILE" ]] || { echo "Nothing in progress. Run: $(basename "$0") start"; exit 1; }
          run_claude --resume "$(cat "$SESSION_FILE")" "$*" ;;
  status) if [[ -s "$SESSION_FILE" ]]; then echo "In progress: waiting for your answer (started $(date -r "$SESSION_FILE" '+%F %R'))"
          else echo "Nothing in progress."; fi ;;
  *)      sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
